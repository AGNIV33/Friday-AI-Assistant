# Friday AI Assistant — Environment Variables
# Copy this file to `.env` and fill in your keys. Never commit `.env`.

# Required — voice-to-voice conversation
GEMINI_API_KEY="your_gemini_api_key_here"

# Optional — AI image generation (NVIDIA NIM APIs)
NVIDIA_API_KEY="your_nvidia_api_key_here"

# Optional — 3D holographic maps
VITE_MAPBOX_TOKEN="your_mapbox_public_token_here"

# Optional — screen & webcam vision analysis
VITE_VISION_API_KEY="your_vision_api_key_here"
VITE_VISION_MODEL="nvidia/nemotron-3-nano-omni-30b-a3b-reasoning"
VITE_VISION_BASE_URL="https://integrate.api.nvidia.com/v1"

# Optional — YouTube search for the music/video/news widgets.
# Get one from Google Cloud Console → APIs & Services → YouTube Data API v3.
# Without it, the news visualizer is unavailable and video search falls back
# to HTML scraping (less reliable, but works).
YOUTUBE_API_KEY="your_youtube_data_api_key_here"
